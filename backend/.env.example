# Copy this file to .env on the VPS (never commit the real .env — it holds secrets).

# The iOS app must send this as `Authorization: Bearer <value>` on every request.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BEARER_TOKEN=

# DuckDNS subdomain pointing at this VPS, and the token from your DuckDNS dashboard.
DOMAIN=jofit.duckdns.org
DUCKDNS_TOKEN=

# --- Phase B: APNs push (optional — leave unset and push is silently skipped) ---
# Key ID and Team ID from the Apple Developer "Keys" page where you created the APNs key.
APNS_KEY_ID=
APNS_TEAM_ID=
# Must match the iOS app's bundle identifier.
APNS_BUNDLE_ID=com.jofit.autobooking
# "true" while testing against a Debug/TestFlight-via-Xcode build signed with a development
# profile; "false" (the default) for TestFlight/App Store builds.
APNS_USE_SANDBOX=false
